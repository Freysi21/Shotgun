<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Freysi21@gmail.com</Authors>
    <Description>Generic end-to-end HTTP test harness for controllers derived from Shotgun&lt;TEntity, TRepository, TId&gt;.</Description>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="Shotgun.Entity" Version="6.2.0" />
  </ItemGroup>

</Project>
